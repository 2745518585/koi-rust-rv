# 复制为 .env 后填写。所有密钥均只从环境变量读取，禁止提交到 Git。

# 非敏感配置文件；实际运行时应从示例复制为 config/agent.toml。
KOI_CONFIG_PATH=./config/agent.toml

# QQ 开放平台机器人凭证
KOI_QQ_APP_ID=your_qq_app_id
KOI_QQ_APP_SECRET=your_qq_app_secret

# OpenAI-compatible Responses API；可指向 OpenAI、兼容网关或本地服务。
KOI_LLM_API_KEY=your_llm_api_key

# Web 管理端和告警 Webhook 的初始访问密钥。
KOI_WEB_ADMIN_TOKEN=change-me-to-a-long-random-token
KOI_ALERT_WEBHOOK_TOKEN=change-me-to-a-long-random-token

# 可选：覆盖日志等级，支持 trace/debug/info/warn/error。
RUST_LOG=info,koi_server=debug
