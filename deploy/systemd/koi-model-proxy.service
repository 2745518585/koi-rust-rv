[Unit]
Description=Koi Rust model proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/koi-rust-rv
ExecStart=/opt/koi-rust-rv/target/debug/koi-model-proxy --config /opt/koi-rust-rv/config/model-proxy.toml
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
