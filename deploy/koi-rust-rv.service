[Unit]
Description=Koi Rust Agent Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ai
WorkingDirectory=/opt/koi-rust-rv
ExecStart=/opt/koi-rust-rv/target/debug/koi-server
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0027
RuntimeDirectory=koi-rust-rv
RuntimeDirectoryMode=0750
Environment=KOI_ADMIN_SOCKET_PATH=/run/koi-rust-rv/koi-admin.sock

# 项目数据目录目前通过 ubuntu 组共享给 ai 用户。
SupplementaryGroups=ubuntu

# 日志统一交给 journald，通过 journalctl -u koi-rust-rv 查看。
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
